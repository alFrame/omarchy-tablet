#!/usr/bin/python3
"""Button remapper for Wacom tablets on the kernel wacom driver.

Runs as the tablet-buttons user service. Reads the "buttons" section of
~/.config/omarchy/tablet.json and re-reads it whenever the file changes.

Pad: left alone while every ExpressKey is on "default", so apps such as
Krita see them as usual. Otherwise the pad is grabbed and its keys turned into
clicks, shortcuts or commands; keys still on "default" are replayed through a
virtual clone with the same name, which libinput again treats as a tablet pad.
Keys are named by the evdev code they send (BTN_RIGHT, BTN_0, ...).

Pen: left alone while every side button is on "default". Once one is
remapped, the real pen is grabbed and replayed through a virtual clone
("<pen> Remap") so pressure and tilt keep working, with the remapped buttons
swallowed and turned into their action instead.

Every press is also written to ~/.cache/omarchy-tablet/last-button so the
bar panel can light up the button that was pressed.
"""
import asyncio
import json
import os
import signal
import subprocess
import sys
import time

import evdev
from evdev import ecodes as e

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import tabletarea  # noqa: E402
import tabletlib  # noqa: E402

HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".config/omarchy/tablet.json")
LAST = os.path.join(HOME, ".cache/omarchy-tablet/last-button")
# Present while the panel's "Identify keys" runs: presses are reported, not acted on.
IDENTIFY = os.path.join(HOME, ".cache/omarchy-tablet/identify")

LEGACY_PAD = {"pad1": "BTN_LEFT", "pad2": "BTN_FORWARD", "pad3": "BTN_BACK", "pad4": "BTN_RIGHT"}

CLICKS = {"left": e.BTN_LEFT, "right": e.BTN_RIGHT, "middle": e.BTN_MIDDLE}
MODIFIERS = {
    "ctrl": e.KEY_LEFTCTRL, "control": e.KEY_LEFTCTRL,
    "shift": e.KEY_LEFTSHIFT,
    "alt": e.KEY_LEFTALT,
    "super": e.KEY_LEFTMETA, "meta": e.KEY_LEFTMETA, "win": e.KEY_LEFTMETA,
}
KEY_ALIASES = {
    "esc": "ESC", "escape": "ESC", "return": "ENTER", "del": "DELETE",
    "pgup": "PAGEUP", "pgdn": "PAGEDOWN", "[": "LEFTBRACE", "]": "RIGHTBRACE",
    "-": "MINUS", "=": "EQUAL", "+": "EQUAL", ",": "COMMA", ".": "DOT",
    "/": "SLASH", ";": "SEMICOLON", "'": "APOSTROPHE", "`": "GRAVE",
    "\\": "BACKSLASH", "plus": "EQUAL", "minus": "MINUS",
}


def log(*args):
    print(*args, file=sys.stderr, flush=True)


def parse_combo(text):
    """'ctrl+shift+z' -> [KEY_LEFTCTRL, KEY_LEFTSHIFT, KEY_Z], or None."""
    parts = [p.strip().lower() for p in str(text).replace(" ", "").split("+")]
    # "ctrl++" means ctrl and the plus key.
    if str(text).endswith("++"):
        parts = parts[:-2] + ["+"]
    codes = []
    for part in parts:
        if not part:
            return None
        if part in MODIFIERS:
            codes.append(MODIFIERS[part])
            continue
        name = KEY_ALIASES.get(part, part.upper())
        code = getattr(e, "KEY_" + name, None)
        if code is None:
            return None
        codes.append(code)
    return codes or None


def load_state():
    try:
        with open(STATE) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}, {}
    buttons = {LEGACY_PAD.get(k, k): v for k, v in (data.get("buttons") or {}).items() if isinstance(v, dict)}
    return buttons, data.get("slotCodes") or {}


def identifying():
    try:
        return time.time() - os.stat(IDENTIFY).st_mtime < 120
    except OSError:
        return False


def mark(button, down):
    if not down:
        return
    try:
        os.makedirs(os.path.dirname(LAST), exist_ok=True)
        with open(LAST, "w") as f:
            f.write(f"{button} {time.time():.3f}\n")
    except OSError:
        pass


class Outputs:
    """Virtual keyboard and mouse the actions are typed and clicked through."""

    def __init__(self):
        keys = list(range(e.KEY_ESC, e.KEY_MICMUTE + 1))
        self.kbd = evdev.UInput({e.EV_KEY: keys}, name="Tablet Buttons Keyboard")
        self.mouse = evdev.UInput(
            {e.EV_KEY: list(CLICKS.values()), e.EV_REL: [e.REL_X, e.REL_Y, e.REL_WHEEL]},
            name="Tablet Buttons Mouse",
        )
        self.held = {}
        self.area = None  # the AreaLock, set once it exists, for the "arealock" action

    def press(self, button, spec, down):
        action = spec.get("action", "none")
        value = spec.get("value", "")
        if action in CLICKS:
            self.mouse.write(e.EV_KEY, CLICKS[action], 1 if down else 0)
            self.mouse.syn()
        elif action == "key":
            if down:
                codes = parse_combo(value)
                if not codes:
                    log(f"{button}: cannot parse shortcut {value!r}")
                    return
                self.held[button] = codes
                for code in codes:
                    self.kbd.write(e.EV_KEY, code, 1)
                self.kbd.syn()
            else:
                for code in reversed(self.held.pop(button, [])):
                    self.kbd.write(e.EV_KEY, code, 0)
                self.kbd.syn()
        elif action == "arealock" and down and self.area:
            self.area.toggle()
        elif action == "command" and down and value.strip():
            subprocess.Popen(["sh", "-c", value], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def release_all(self):
        for button in list(self.held):
            self.press(button, {"action": "key"}, False)
        for code in CLICKS.values():
            self.mouse.write(e.EV_KEY, code, 0)
        self.mouse.syn()


async def events(dev):
    """Events from `dev`. Replaces evdev's async_read_loop, whose futures raise
    InvalidStateError when the task reading them is cancelled."""
    loop = asyncio.get_running_loop()
    queue = asyncio.Queue()

    def ready():
        try:
            for ev in dev.read():
                queue.put_nowait(ev)
        except BlockingIOError:
            pass
        except OSError as exc:  # unplugged
            loop.remove_reader(dev.fd)
            queue.put_nowait(exc)

    loop.add_reader(dev.fd, ready)
    try:
        while True:
            ev = await queue.get()
            if isinstance(ev, Exception):
                raise ev
            yield ev
    finally:
        try:
            loop.remove_reader(dev.fd)
        except (ValueError, OSError):
            pass


def open_device(path):
    try:
        return evdev.InputDevice(path) if path else None
    except OSError:
        return None


def clone_of(dev, name):
    caps = dev.capabilities(absinfo=True)
    caps.pop(e.EV_SYN, None)
    return evdev.UInput(caps, name=name, vendor=dev.info.vendor, product=dev.info.product,
                        version=dev.info.version, bustype=dev.info.bustype,
                        input_props=dev.input_props())


async def run_pad(dev, buttons, out):
    def action(name):
        return buttons.get(name, {"action": "none"}).get("action", "none")

    keys = [tabletlib.KEY_NAMES.get(c, f"KEY_{c}")
            for c in dev.capabilities().get(e.EV_KEY, []) if not 0x140 <= c <= 0x14F]
    if all(action(k) == "default" for k in keys):
        # Nothing remapped: leave the pad to the apps, only report presses for the panel.
        try:
            async for ev in events(dev):
                if ev.type == e.EV_KEY and ev.value in (0, 1) and not 0x140 <= ev.code <= 0x14F:
                    mark(tabletlib.KEY_NAMES.get(ev.code, f"KEY_{ev.code}"), ev.value == 1)
        finally:
            dev.close()
        return

    # The clone keeps the pad's exact name: udev only tags a device as a tablet
    # pad (ID_INPUT_TABLET_PAD) by name, and without that apps never see it.
    clone = clone_of(dev, dev.name) if any(action(k) == "default" for k in keys) else None
    dev.grab()
    try:
        async for ev in events(dev):
            if ev.type == e.EV_KEY and not 0x140 <= ev.code <= 0x14F:
                name = tabletlib.KEY_NAMES.get(ev.code, f"KEY_{ev.code}")
                if ev.value in (0, 1):
                    mark(name, ev.value == 1)
                if ev.value == 1 and identifying():
                    continue
                if action(name) != "default":
                    if ev.value in (0, 1):
                        out.press(name, buttons.get(name, {"action": "none"}), ev.value == 1)
                    continue
            if clone:
                clone.write_event(ev)
    finally:
        try:
            dev.ungrab()
        except OSError:
            pass
        if clone:
            clone.close()
        dev.close()


async def run_pen(dev, buttons, out, area):
    names = tabletlib.PEN_BUTTONS
    remapped = {code for code, name in names.items()
                if buttons.get(name, {}).get("action", "default") != "default"}
    if not remapped and not area.swallows_taps():
        # Nothing to change: leave the real pen alone, only report presses for the panel.
        try:
            async for ev in events(dev):
                if ev.type == e.EV_KEY and ev.code in names:
                    mark(names[ev.code], ev.value == 1)
        finally:
            dev.close()
        return

    clone = clone_of(dev, dev.name + tabletlib.REMAP_SUFFIX)
    dev.grab()
    swallow = False  # the tip is down on a tap that only activates an app
    routed = area.swallows_taps()
    ignore = area.ignores_taps()
    def handle(ev):
        nonlocal swallow
        if ev.type == e.EV_KEY and ev.code == e.BTN_TOUCH:
            if swallow:
                swallow = ev.value != 0
                return
        elif swallow and ev.type == e.EV_ABS and ev.code == e.ABS_PRESSURE:
            clone.write(e.EV_ABS, e.ABS_PRESSURE, 0)
            return
        elif ev.type == e.EV_KEY and ev.code in (e.BTN_TOOL_PEN, e.BTN_TOOL_RUBBER) and ev.value == 0:
            swallow = False
        if ev.type == e.EV_KEY and ev.code in names:
            name = names[ev.code]
            mark(name, ev.value == 1)
            if ev.code in remapped:
                if ev.value in (0, 1):
                    out.press(name, buttons[name], ev.value == 1)
                return
        clone.write_event(ev)

    frame = []
    try:
        async for ev in events(dev):
            frame.append(ev)
            if ev.type != e.EV_SYN or ev.code != e.SYN_REPORT:
                continue
            # The kernel reports the pressure of a touch-down before its BTN_TOUCH, in the same
            # frame, so the whole frame is looked at before any of it goes out.
            if routed and any(f.type == e.EV_KEY and f.code == e.BTN_TOUCH and f.value == 1 for f in frame):
                if area.rect is None:
                    # Focus follows the pen, so look again rather than trust a flag that may lag a tap.
                    # (Locked, the focus is the locked app and a change arrives as an event.)
                    await area.evaluate()
                    tabletarea.log("tap", "activates" if area.armed else "ignored" if ignore else "passed",
                                   f"(focus={area.focus})")
                if area.armed:
                    swallow = True
                    area.activate()
                elif ignore and area.in_manager:
                    swallow = True  # a file manager has focus: the tap is dropped
            for f in frame:
                handle(f)
            frame = []
    finally:
        try:
            dev.ungrab()
        except OSError:
            pass
        clone.close()
        dev.close()


def state_mtime():
    try:
        return os.stat(STATE).st_mtime
    except OSError:
        return 0


async def main():
    out = Outputs()
    tasks = []
    signature = None
    lock = tabletarea.AreaLock()
    out.area = lock
    area = asyncio.create_task(lock.run())
    asyncio.get_running_loop().add_signal_handler(signal.SIGTERM, asyncio.current_task().cancel)
    try:
        await watch(out, tasks, signature, lock)
    finally:
        # Cancelling lets the area lock hand the pen back before the service stops.
        area.cancel()
        await asyncio.gather(area, return_exceptions=True)


async def watch(out, tasks, signature, area):
    while True:
        tablet = tabletlib.detect()
        pen_path = tablet["pen"]["path"] if tablet and tablet.get("pen") else None
        pad_path = tablet["pad"]["path"] if tablet and tablet.get("pad") else None
        current = (state_mtime(), pen_path, pad_path)
        alive = all(not t.done() for t in tasks)
        if current != signature or not alive:
            for t in tasks:
                t.cancel()
            await asyncio.gather(*tasks, return_exceptions=True)
            out.release_all()
            tasks = []
            saved, slot_codes = load_state()
            buttons = {}
            if tablet:
                key = f'{tablet["vendor"]}:{tablet["product"]}'
                buttons = tabletlib.resolve_buttons(saved, tabletlib.describe(tablet, 0, slot_codes.get(key)))
            pad, pen = open_device(pad_path), open_device(pen_path)
            if pad:
                tasks.append(asyncio.create_task(run_pad(pad, buttons, out)))
            if pen:
                tasks.append(asyncio.create_task(run_pen(pen, buttons, out, area)))
            log("tablet:", tablet["kernelName"] if tablet else "-",
                "| pen" if pen else "| -", "pad" if pad else "-",
                "| pen remap:", [k for k in ("pen1", "pen2", "pen3")
                                 if buttons.get(k, {}).get("action", "default") != "default"])
            signature = current
        await asyncio.sleep(1)


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        pass
