#!/usr/bin/python3
"""Backend for the Tablet bar widget.

Settings live in ~/.config/omarchy/tablet.json; every change regenerates
~/.config/hypr/tablet.lua (required from hyprland.lua) and reloads Hyprland.

  tablet-ctl status                 -> JSON: settings, devices, monitors, area
  tablet-ctl set '<json patch>'     -> merge patch, write, reload, print status
  tablet-ctl reset                  -> restore defaults
  tablet-ctl setup                  -> one-time install: tablet.lua, hyprland.lua
                                       require line, tablet-buttons user service
"""
import json
import os
import subprocess
import sys

HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".config/omarchy/tablet.json")
LUA = os.path.join(HOME, ".config/hypr/tablet.lua")
HYPRLAND = os.path.join(HOME, ".config/hypr/hyprland.lua")
REQUIRE = 'require("hypr.tablet")'
SERVICE = os.path.join(HOME, ".config/systemd/user/tablet-buttons.service")
PLUGIN_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

PEN = "wacom-bamboopt-2fg-4x5-pen"
# tablet-buttons replays the pen through this clone while a side button is remapped.
PEN_REMAP = "wacom-bamboopt-2fg-4x5-pen-remap"
FINGER = "wacom-bamboopt-2fg-4x5-finger"
TABLET_MM = (147.2, 92.0)  # CTH-460 active surface

DEFAULTS = {
    "output": "",             # monitor name, "" = every monitor
    "rotation": 0,            # degrees: 0 / 90 / 180 / 270
    "leftHanded": False,
    "areaPercent": 100,       # share of the surface used, centred
    "matchAspect": True,      # crop the area to the monitor's aspect ratio
    "pressure": 0,            # 0..100, higher = lighter touch reaches full
    "fingerEnabled": True,
    "fingerSpeed": 0.0,       # -1..1
    "naturalScroll": True,
    "tapToClick": True,
    "buttons": {
        "pen1": {"action": "default", "value": ""},
        "pen2": {"action": "default", "value": ""},
        "pad1": {"action": "key", "value": "ctrl+z"},
        "pad2": {"action": "key", "value": "ctrl+shift+z"},
        "pad3": {"action": "right", "value": ""},
        "pad4": {"action": "middle", "value": ""},
    },
    # Pad keys as they sit on the tablet, top to bottom (set by "Identify keys").
    "padOrder": ["pad1", "pad2", "pad3", "pad4"],
}
PAD_KEYS = ["pad1", "pad2", "pad3", "pad4"]
ACTIONS = {"default", "left", "right", "middle", "key", "command", "none"}


def hypr_json(*args):
    try:
        out = subprocess.run(["hyprctl", *args, "-j"], capture_output=True, text=True, timeout=5)
        return json.loads(out.stdout or "null")
    except Exception:
        return None


def load():
    data = dict(DEFAULTS)
    try:
        with open(STATE) as f:
            saved = json.load(f)
        data.update({k: v for k, v in saved.items() if k in DEFAULTS})
    except (OSError, ValueError):
        pass
    return sanitize(data)


def sanitize(s):
    out = dict(DEFAULTS)
    out["output"] = str(s.get("output", ""))
    out["rotation"] = int(s.get("rotation", 0)) % 360 // 90 * 90
    out["leftHanded"] = bool(s.get("leftHanded"))
    out["areaPercent"] = max(30, min(100, int(round(float(s.get("areaPercent", 100))))))
    out["matchAspect"] = bool(s.get("matchAspect"))
    out["pressure"] = max(0, min(100, int(round(float(s.get("pressure", 0))))))
    out["fingerEnabled"] = bool(s.get("fingerEnabled"))
    out["fingerSpeed"] = round(max(-1.0, min(1.0, float(s.get("fingerSpeed", 0)))), 2)
    out["naturalScroll"] = bool(s.get("naturalScroll"))
    out["tapToClick"] = bool(s.get("tapToClick"))
    buttons = {}
    for key, fallback in DEFAULTS["buttons"].items():
        spec = (s.get("buttons") or {}).get(key) or fallback
        action = spec.get("action", fallback["action"])
        if action not in ACTIONS or (action == "default" and not key.startswith("pen")):
            action = fallback["action"]
        buttons[key] = {"action": action, "value": str(spec.get("value", ""))[:200]}
    out["buttons"] = buttons
    order = [str(k) for k in (s.get("padOrder") or [])]
    out["padOrder"] = order if sorted(order) == PAD_KEYS else list(PAD_KEYS)
    return out


def monitors():
    result = []
    for m in hypr_json("monitors") or []:
        w = m["width"] / m["scale"]
        h = m["height"] / m["scale"]
        if m.get("transform", 0) % 2 == 1:
            w, h = h, w
        result.append({
            "name": m["name"],
            "description": m.get("description", ""),
            "x": m["x"], "y": m["y"], "w": w, "h": h,
        })
    return result


def target_aspect(s, mons):
    chosen = [m for m in mons if m["name"] == s["output"]] or mons
    if not chosen:
        return None
    left = min(m["x"] for m in chosen)
    top = min(m["y"] for m in chosen)
    right = max(m["x"] + m["w"] for m in chosen)
    bottom = max(m["y"] + m["h"] for m in chosen)
    aspect = (right - left) / max(1, bottom - top)
    # A quarter-turn tablet is held portrait, so the surface meets the screen sideways.
    if s["rotation"] in (90, 270):
        aspect = 1 / aspect
    return aspect


def area(s, mons):
    w, h = TABLET_MM
    aspect = target_aspect(s, mons) if s["matchAspect"] else None
    if aspect:
        if w / h > aspect:
            w = h * aspect
        else:
            h = w / aspect
    k = s["areaPercent"] / 100
    w, h = w * k, h * k
    x = (TABLET_MM[0] - w) / 2
    y = (TABLET_MM[1] - h) / 2
    return {"w": round(w, 1), "h": round(h, 1), "x": round(x, 1), "y": round(y, 1)}


def lua_bool(v):
    return "true" if v else "false"


def render(s, a):
    transform = {0: 0, 90: 1, 180: 2, 270: 3}[s["rotation"]]
    full = a["w"] >= TABLET_MM[0] - 0.05 and a["h"] >= TABLET_MM[1] - 0.05
    area_lines = "" if full else (
        f'    active_area_size = "{a["w"]} {a["h"]}",\n'
        f'    active_area_position = "{a["x"]} {a["y"]}",\n'
    )
    pressure_max = round(1.0 - s["pressure"] / 100 * 0.6, 3)
    pen_blocks = "\n".join(f"""hl.device({{
    name = "{name}",
    output = "{s["output"]}",
    transform = {transform},
    left_handed = {lua_bool(s["leftHanded"])},
{area_lines}}})
""" for name in (PEN, PEN_REMAP))
    return f"""-- Wacom Bamboo Pen & Touch (CTH-460).
-- GENERATED by the Tablet bar widget (~/.config/omarchy/tablet.json).
-- Change settings from the bar; manual edits here are overwritten.

{pen_blocks}
hl.config({{
    input = {{
        tablettool = {{
            pressure_range_min = 0.0,
            pressure_range_max = {pressure_max},
        }},
    }},
}})

hl.device({{
    name = "{FINGER}",
    enabled = {lua_bool(s["fingerEnabled"])},
    sensitivity = {s["fingerSpeed"]},
    natural_scroll = {lua_bool(s["naturalScroll"])},
    tap_to_click = {lua_bool(s["tapToClick"])},
}})
"""


def write(s):
    mons = monitors()
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(s, f, indent=2)
    os.replace(tmp, STATE)
    tmp = LUA + ".tmp"
    with open(tmp, "w") as f:
        f.write(render(s, area(s, mons)))
    os.replace(tmp, LUA)
    subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=10)
    errors = subprocess.run(["hyprctl", "configerrors"], capture_output=True, text=True, timeout=5).stdout.strip()
    return errors


def hyprland_wired():
    try:
        with open(HYPRLAND) as f:
            return any(line.strip() == REQUIRE for line in f)
    except OSError:
        return False


def service_active():
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", "tablet-buttons"]).returncode == 0


def evdev_available():
    return subprocess.run(["/usr/bin/python3", "-c", "import evdev"], capture_output=True).returncode == 0


def setup(s):
    """Idempotent one-time install. tablet.lua is written before the require
    line goes in, so Hyprland never reloads into a missing module."""
    error = write(s)
    if not hyprland_wired():
        with open(HYPRLAND) as f:
            text = f.read()
        anchor = 'require("hypr.input")\n'
        if anchor in text:
            text = text.replace(anchor, anchor + REQUIRE + "\n", 1)
        else:
            text = text.rstrip("\n") + "\n\n-- Wacom tablet settings (Tablet bar widget)\n" + REQUIRE + "\n"
        with open(HYPRLAND, "w") as f:
            f.write(text)
        subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=10)
    os.makedirs(os.path.dirname(SERVICE), exist_ok=True)
    with open(SERVICE, "w") as f:
        f.write(f"""[Unit]
Description=Wacom tablet button remapper (Omarchy Tablet widget)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 {PLUGIN_DIR}/bin/tablet-buttons
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
""")
    subprocess.run(["systemctl", "--user", "daemon-reload"])
    subprocess.run(["systemctl", "--user", "enable", "tablet-buttons.service"], capture_output=True)
    subprocess.run(["systemctl", "--user", "restart", "tablet-buttons.service"])
    return error


def status(s, error=""):
    mons = monitors()
    devices = hypr_json("devices") or {}
    tablets = [t.get("name") for t in devices.get("tablets", [])]
    mice = [m.get("name") for m in devices.get("mice", [])]
    return {
        "settings": s,
        "pen": PEN in tablets or PEN_REMAP in tablets,
        "buttonsService": service_active(),
        "setupDone": hyprland_wired() and os.path.exists(LUA) and os.path.exists(SERVICE),
        "evdev": evdev_available(),
        "wacomDriver": os.path.isdir("/sys/module/wacom"),
        "finger": FINGER in mice,
        "monitors": [{"name": m["name"], "description": m["description"]} for m in mons],
        "area": area(s, mons),
        "tabletMm": {"w": TABLET_MM[0], "h": TABLET_MM[1]},
        "error": error,
    }


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    s = load()
    error = ""
    if cmd == "set":
        patch = json.loads(sys.argv[2]) if len(sys.argv) > 2 else {}
        if "buttons" in patch:
            merged = {k: dict(v) for k, v in s.get("buttons", {}).items()}
            for key, spec in patch["buttons"].items():
                merged[key] = {**merged.get(key, {}), **spec}
            patch["buttons"] = merged
        s = sanitize({**s, **patch})
        error = write(s)
    elif cmd == "reset":
        s = dict(DEFAULTS)
        error = write(s)
    elif cmd == "setup":
        error = setup(s)
    elif cmd != "status":
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    print(json.dumps(status(s, error)))


if __name__ == "__main__":
    main()
